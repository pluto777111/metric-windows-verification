+namespace {
+bool read_control_pattern(u32 track, control::PatternEvent* events, u32 capacity, u32& count) {
+    if (track >= control::tracks || !events || capacity < notes::capacity ||
+        !word(0x840a0524) || word(kProjectLoading)) return false;
+    if (!stock<u32(u32)>(0x8d586014)(track) || stock<u32(u32)>(0x8d586800)(track) != 16)
+        return false;
+    const u32 scale = stock<u32(u32)>(0x8d586b50)(track);
+    if (scale >= 16) return false;
+    const u32 numerator = word(0x840a36e0 + scale * 8);
+    const u32 denominator = word(0x840a36e4 + scale * 8);
+    if (!numerator || numerator != denominator) return false;
+    const auto* container = stock<const notes::Container*(u32, u32)>(0x8d5875c8)(track, 0);
+    bool used[notes::capacity];
+    if (!container || !notes::valid(*container, used)) return false;
+
+    count = 0;
+    for (i32 slot = container->head; slot != -1; slot = container->slots[slot].next) {
+        const auto& n = container->slots[slot].note;
+        if (n.flags & notes::held_flag || !n.length || !n.velocity ||
+            n.velocity >= 128 || n.pitch >= 128 || n.position < -240 || n.position >= 7680) continue;
+        // 480 stock ticks per step at scale 1 and 24 METRIC ticks per step.
+        const u32 position = static_cast<u32>(n.position < 0 ? n.position + 7680 : n.position);
+        const u32 length = n.length / 20 + (n.length % 20 >= 10);
+        events[count++] = {(position + 10) / 20 % 384, length ? length : 1, n.pitch, n.velocity};
+    }
+    return true;
+}
+}
