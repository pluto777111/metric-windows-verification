+bool edit_own_aux_parameter(u32 track, u32 slot, i32 value) {
+    if (track < control::tracks || track >= control::all_tracks || track != selected_track() ||
+        !owning[track] || !hosts[track] || slot >= kEngineControls || value < 0 ||
+        word(kProjectLoading)) return false;
+    const u32 pattern = stock<u32(u32)>(0x8d587708)(track);
+    if (!pattern) return false;
+    *at<i32>(pattern + 0x3864 + slot * 4) = value;
+    param_set(kProject, track, slot, value);
+    return true;
+}
+
+u32 song_ticks(u32 position, u32 rate, u32 stretch) {
+    const u32 divisor = 20 * rate;  // Stock uses 480 ticks/step; song time uses 24.
+    return (position * stretch + divisor / 2) / divisor;
+}
+
+control::HostPattern control_host_pattern(u32 track) {
+    control::HostPattern result{0,0,0,0,control::no_held_step};
+    if (track < control::tracks || track >= control::all_tracks) return result;
+    const u32 project = word(0x840a0524);
+    if (!project || word(kProjectLoading)) return result;
+    const u32 pattern = stock<u32(u32)>(0x8d586014)(track);
+    const u32 first = project + 0xd7c + track * 0x53f44;
+    if (pattern < first || pattern-first >= 16*0x53f4 || (pattern-first)%0x53f4) return result;
+    const u32 steps = stock<u32(u32)>(0x8d586800)(track);
+    const u32 scale = stock<u32(u32)>(0x8d586b50)(track);
+    if (!steps || steps > 128 || scale >= 16) return result;
+    const u32 rate = word(0x840a36e0 + scale * 8);
+    const u32 stretch = word(0x840a36e4 + scale * 8);
+    if (!rate || rate > 24 || 24 % rate || !stretch || stretch > 32) return result;
+    const i32 length = static_cast<i32>(480 * steps);
+    const i32 position = stock<i32(u32, u32)>(0x8d592a94)(0x860c6adc, track) % length;
+    result.cycle = song_ticks(length, rate, stretch);
+    result.phase = song_ticks(position < 0 ? position + length : position, rate, stretch) % result.cycle;
+    result.pattern = (pattern-first)/0x53f4;
+    result.steps = steps;
+    if (track == selected_track() && stock<u32()>(0x8d5b7e34)()) {
+        const u32 key = stock<u32()>(0x8d5b7e4c)();
+        const u32 step = key + 16 * stock<u32(u32)>(0x8d585fb4)(track);
+        if (key < 16 && step < steps) result.held_step = step;
+    }
+    return result;
+}
+
+bool read_control_pattern(u32 track, control::PatternEvent* events, u32 capacity,
+                          u32& count, control::PatternTiming& timing) {
+    if (track >= control::tracks || !events || capacity < notes::capacity ||
+        !word(0x840a0524) || word(kProjectLoading)) return false;
+    if (!stock<u32(u32)>(0x8d586014)(track)) return false;
+    const u32 steps = stock<u32(u32)>(0x8d586800)(track);
+    if (!steps || steps > 65535) return false;
+    const u32 scale = stock<u32(u32)>(0x8d586b50)(track);
+    if (scale >= 16) return false;
+    // The stock table describes track speed relative to the song clock.
+    const u32 rate = word(0x840a36e0 + scale * 8);
+    const u32 stretch = word(0x840a36e4 + scale * 8);
+    if (!rate || rate > 24 || 24 % rate || !stretch || stretch > 32) return false;
+    const auto* container = stock<const notes::Container*(u32, u32)>(0x8d5875c8)(track, 0);
+    bool used[notes::capacity];
+    if (!container || !notes::valid(*container, used)) return false;
+
+    const i32 length = static_cast<i32>(480 * steps);
+    const i32 position = stock<i32(u32, u32)>(0x8d592a94)(0x860c6adc, track) % length;
+    timing.cycle = song_ticks(length, rate, stretch);
+    timing.phase = song_ticks(position < 0 ? position + length : position, rate, stretch) % timing.cycle;
+    count = 0;
+    for (i32 slot = container->head; slot != -1; slot = container->slots[slot].next) {
+        const auto& n = container->slots[slot].note;
+        if (n.flags & notes::held_flag || !n.length || !n.velocity ||
+            n.velocity >= 128 || n.pitch >= 128 || n.position < -240 || n.position >= length) continue;
+        const u32 onset = static_cast<u32>(n.position < 0 ? n.position + length : n.position);
+        const u32 limit = 1536 * 20 * rate;
+        const u32 duration = song_ticks(n.length < limit ? n.length : limit, rate, stretch);
+        events[count++] = {song_ticks(onset, rate, stretch) % timing.cycle,
+                           duration ? duration : 1, n.pitch, n.velocity};
+    }
+    return true;
+}
+}
