diff --git a/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp b/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp
new file mode 100644
index 0000000..50dcc94
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp
@@ -0,0 +1,201 @@
+#pragma once
+#include "device_controls.hpp"
+
+namespace ott {
+constexpr i32 Controls::* parameters[] = {
+    &Controls::depth, &Controls::time, &Controls::low_trim, &Controls::high_trim,
+    &Controls::upward, &Controls::downward, &Controls::level_match, &Controls::crossover,
+    &Controls::low_protect, &Controls::focus, &Controls::character
+};
+constexpr u32 parameter_count = sizeof(parameters) / sizeof(parameters[0]);
+constexpr u32 project_bytes = 1 + settings_count * (1 + 4 * parameter_count);
+constexpr u32 message_id = 128, last_parameter_id = message_id + parameter_count;
+using Byte = unsigned char;
+
+inline TrackSettings& config(ProjectSettings& project, u32 index) {
+    return index == mix_index ? project.mix : project.track[index];
+}
+inline const TrackSettings& config(const ProjectSettings& project, u32 index) {
+    return index == mix_index ? project.mix : project.track[index];
+}
+inline bool valid(i32 Controls::* parameter, u32 value) {
+    if (value > static_cast<u32>(q31::maximum)) return false;
+    if (parameter == &Controls::focus) return value <= Mono;
+    if (parameter == &Controls::character) return value <= Mix;
+    if (parameter == &Controls::level_match) return !value || value == static_cast<u32>(q31::maximum);
+    return true;
+}
+
+inline u32 encode_project(const ProjectSettings& project, Byte* data) {
+    data[0] = 7;
+    u32 at = 1;
+    for (u32 index = 0; index < settings_count; ++index) {
+        const auto& track = config(project, index);
+        data[at++] = track.enabled;
+        for (const auto parameter : parameters) {
+            const u32 value = static_cast<u32>(track.controls.*parameter);
+            for (u32 byte = 0; byte < 4; ++byte) data[at++] = static_cast<Byte>(value >> (8 * byte));
+        }
+    }
+    return at;
+}
+
+inline bool decode_project(const Byte* data, u32 count, ProjectSettings& project) {
+    if (!data || !count || data[0] < 3 || data[0] > 7) return false;
+    const unsigned version = data[0];
+    const bool had_mid_trim = version < 5;
+    const u32 slots = version == 7 ? parameter_count : version == 5 ? 7 : 8;
+    const u32 count_settings = version == 7 ? settings_count : TrackInserts::track_count;
+    if (count != 1 + count_settings * (1 + 4 * slots)) return false;
+    ProjectSettings next{};
+    u32 at = 1, enabled = 0;
+    for (u32 index = 0; index < count_settings; ++index) {
+        auto& track = config(next, index);
+        if (version < 7) track.controls.character = Drum;
+        if (data[at] > 1) return false;
+        track.enabled = data[at++] != 0;
+        if (index < mix_index) enabled += track.enabled;
+        for (u32 slot = 0; slot < slots; ++slot) {
+            u32 value = 0;
+            for (u32 byte = 0; byte < 4; ++byte) value |= static_cast<u32>(data[at++]) << (8 * byte);
+            if (value > static_cast<u32>(q31::maximum)) return false;
+            if (had_mid_trim && slot == 6) continue;
+            const auto parameter = parameters[had_mid_trim && slot > 6 ? slot - 1 : slot];
+            if (version == 3 && parameter == &Controls::level_match) continue;
+            if (!valid(parameter, value)) return false;
+            track.controls.*parameter = static_cast<i32>(value);
+        }
+    }
+    if (enabled > TrackInserts::insert_limit) return false;
+    project = next;
+    return true;
+}
+
+template <class Send>
+void publish(const ProjectSettings& project, u32 selection, bool reset, u32 sequence, Send send) {
+    const u32 first = selection ? selection - 1 : 0;
+    const u32 end = selection ? selection : TrackInserts::track_count;
+    u32 enable = 0;
+    for (u32 index = first; index < end; ++index)
+        if (config(project, index).enabled) enable |= 1u << (index == mix_index ? 0 : index);
+    sequence &= 0x7fffu;
+    send(message_id, static_cast<i32>(sequence << 16 | enable << 8 | selection << 1 | (reset ? 1u : 0u)));
+    for (u32 index = first; index < end; ++index)
+        for (u32 slot = 0; slot < parameter_count; ++slot)
+            send(message_id + 1 + slot, config(project, index).controls.*parameters[slot]);
+    send(message_id, static_cast<i32>(0x80000000u | sequence));
+}
+
+class AudioInsert {
+public:
+    bool receive(u32 id, i32 value) {
+        if (id < message_id || id > last_parameter_id) return false;
+        const u32 word = static_cast<u32>(value);
+        if (id == message_id && !(word & 0x80000000u)) {
+            begin(word);
+        } else if (id == message_id) {
+            if (reading_ && index_ == end_ && word == (0x80000000u | sequence_)) {
+                u32 enabled = 0;
+                for (const auto& track : staged_.track) enabled += track.enabled;
+                if (enabled <= TrackInserts::insert_limit) {
+                    pending_ = staged_;
+                    if (end_ == settings_count) {
+                        mix_changed_ = true;
+                        mix_reset_ = mix_reset_ || reset_;
+                    } else {
+                        changed_ = true;
+                        reset_pending_ = reset_pending_ || reset_;
+                    }
+                }
+            }
+            reading_ = false;
+        } else if (reading_) {
+            const auto parameter = parameters[slot_];
+            if (index_ == end_ || id != message_id + 1 + slot_ || !valid(parameter, word)) {
+                reading_ = false;
+            } else {
+                config(staged_, index_).controls.*parameter = value;
+                if (++slot_ == parameter_count) {
+                    slot_ = 0;
+                    ++index_;
+                }
+            }
+        }
+        return true;
+    }
+
+    void start_track(u32 track) {
+        if (track <= last_track_ && changed_) {
+            inserts_.configure(pending_.track);
+            if (reset_pending_) inserts_.reset();
+            changed_ = reset_pending_ = false;
+        }
+        last_track_ = track;
+    }
+
+    bool needs_tail(u32 track) const { return inserts_.needs_tail(track); }
+    u32 process(u32 track, i32* sum, u32 voices) { return inserts_.process(track, sum, voices); }
+
+    // Stock supplies split stereo buffers here, after EQ. The static working
+    // buffer keeps this adapter off the audio stack. Bypass performs no DSP.
+    void process_mix(i32* left, i32* right) {
+        if (mix_changed_) {
+            mix_ = pending_.mix;
+            if (mix_reset_) {
+                mix_processor_.reset();
+                mix_wet_ = 0;
+            }
+            mix_changed_ = mix_reset_ = false;
+        }
+        if (!mix_.enabled && !mix_wet_) return;
+        for (u32 i = 0; i < opxy::block_frames; ++i) {
+            mix_buffer_[2*i] = left[i];
+            mix_buffer_[2*i+1] = right[i];
+        }
+        mix_processor_.process(mix_buffer_, mix_.controls);
+        constexpr i32 ceiling = 256;
+        if (mix_.enabled && mix_wet_ == ceiling) {
+            for (u32 i = 0; i < opxy::block_frames; ++i) {
+                left[i] = mix_buffer_[2*i];
+                right[i] = mix_buffer_[2*i+1];
+            }
+            return;
+        }
+        for (u32 i = 0; i < opxy::block_frames; ++i) {
+            if (mix_.enabled && mix_wet_ < ceiling) ++mix_wet_;
+            if (!mix_.enabled && mix_wet_) --mix_wet_;
+            left[i] = static_cast<i32>((q31::wide(left[i], ceiling - mix_wet_) +
+                                        q31::wide(mix_buffer_[2*i], mix_wet_)) / ceiling);
+            right[i] = static_cast<i32>((q31::wide(right[i], ceiling - mix_wet_) +
+                                         q31::wide(mix_buffer_[2*i+1], mix_wet_)) / ceiling);
+        }
+        if (!mix_.enabled && !mix_wet_) mix_processor_.reset_signal();
+    }
+
+private:
+    void begin(u32 word) {
+        const u32 selected = (word >> 1) & 15;
+        reading_ = selected <= settings_count && !(word & 0xe0);
+        if (!reading_) return;
+        reset_ = (word & 1) != 0;
+        sequence_ = word >> 16;
+        index_ = selected ? selected - 1 : 0;
+        end_ = selected ? selected : TrackInserts::track_count;
+        slot_ = 0;
+        staged_ = pending_;
+        for (u32 index = index_; index < end_; ++index)
+            config(staged_, index).enabled = ((word >> (8 + (index == mix_index ? 0 : index))) & 1) != 0;
+    }
+
+    TrackInserts inserts_;
+    ProjectSettings pending_{}, staged_{};
+    TrackSettings mix_ = mix_defaults();
+    Processor mix_processor_;
+    i32 mix_buffer_[2 * opxy::block_frames]{};
+    i32 mix_wet_ = 0;
+    u32 last_track_ = TrackInserts::track_count;
+    u32 sequence_ = 0, index_ = 0, end_ = 0, slot_ = 0;
+    bool reading_ = false, reset_ = false, changed_ = false, reset_pending_ = false;
+    bool mix_changed_ = false, mix_reset_ = false;
+};
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp b/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp
new file mode 100644
index 0000000..4da0425
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp
@@ -0,0 +1,492 @@
+#pragma once
+
+#include <opxy/audio.hpp>
+#include <opxy/q31.hpp>
+#include "faust_ott_tables.hpp"
+
+// Fixed-point port of David Braun's MIT-licensed co.xfer_ott model in the
+// Faust Libraries revision ecf019c75d9860903d854c8c72a0907c8ac3b4e4.
+// The Butterworth SVF cascade follows the equivalent transfer functions in
+// Faust's crossover3LR4. The host reference runs the upstream Faust function.
+namespace ott {
+using opxy::i32;
+using opxy::i64;
+using opxy::u32;
+namespace q31 = opxy::q31;
+
+enum Focus { Stereo, Mid, Side, Mono };
+enum Character { Drum, Pad, Mix };
+
+struct Controls {
+    constexpr Controls(i32 d = q31::maximum, i32 c = Mix) : depth(d), character(c) {}
+    i32 depth = q31::maximum;
+    i32 time = q31::maximum / 2;
+    i32 low_trim = q31::maximum / 2;
+    i32 high_trim = q31::maximum / 2;
+    i32 crossover = q31::maximum / 2;
+    i32 upward = q31::maximum / 2;
+    i32 downward = q31::maximum / 2;
+    i32 level_match = q31::maximum;
+    i32 low_protect = 0;
+    i32 focus = Stereo;
+    i32 character;
+};
+
+class Processor {
+    static constexpr i32 db_unit = 1 << 16;
+    // Keep the installed build's gain timing around transients.
+
+
+    struct Coefficients {
+        i32 g_q31, damping_q31, input_q31;
+    };
+
+    // Rearrange the SVF integrators so the lowpass and bandpass need only
+    // three multiplies. The Q28 state protects quiet-band precision.
+    struct Filter {
+        i32 integrator1 = 0, integrator2 = 0;
+        void fold(const Filter& right) {
+            integrator1 = static_cast<i32>((static_cast<i64>(integrator1) + right.integrator1) >> 1);
+            integrator2 = static_cast<i32>((static_cast<i64>(integrator2) + right.integrator2) >> 1);
+        }
+        i32 tick(i32 input, const Coefficients& coefficients, i32& low) {
+            const i32 delta1 = rounded(coefficients.input_q31, input - integrator2) -
+                               rounded(coefficients.damping_q31, integrator1);
+            const i32 band = integrator1 + delta1;
+            const i32 delta2 = rounded(coefficients.g_q31, band);
+            low = integrator2 + delta2;
+            integrator1 = band + delta1;
+            integrator2 = low + delta2;
+            return band;
+        }
+    };
+
+    struct Split {
+        Filter lower[2], upper[2], phase;
+        void fold(const Split& right) {
+            for (u32 i = 0; i < 2; ++i) {
+                lower[i].fold(right.lower[i]);
+                upper[i].fold(right.upper[i]);
+            }
+            phase.fold(right.phase);
+        }
+        void tick(i32 input, i32 (&bands)[3], const Coefficients& upper_coeff) {
+            constexpr Coefficients lower_coeff{13508514, 19018953, 13388877};
+            i32 lower_low;
+            const i32 lower_mid = lower[0].tick(input, lower_coeff, lower_low);
+            lower[1].tick(lower_low, lower_coeff, lower_low);
+            // The LR4 outputs sum to the first section's allpass response.
+            // Find the high branch by subtraction and share both SVF stages.
+            const i32 rest = allpass(input, lower_mid) - lower_low;
+
+            i32 upper_low;
+            const i32 upper_mid = upper[0].tick(rest, upper_coeff, upper_low);
+            upper[1].tick(upper_low, upper_coeff, bands[1]);
+            bands[2] = allpass(rest, upper_mid) - bands[1];
+
+            i32 unused_low;
+            const i32 phase_band = phase.tick(lower_low, upper_coeff, unused_low);
+            bands[0] = allpass(lower_low, phase_band);
+        }
+
+        static i32 allpass(i32 input, i32 band) {
+            constexpr i32 sqrt_two_q30 = 1518500250;
+            return input - 4 * rounded(sqrt_two_q30, band);
+        }
+    };
+
+    struct Curve {
+        i32 up_threshold, down_threshold, up_width, down_width;
+        i32 inv_up_width, inv_down_width, up_slope, makeup, cap, floor;
+        i32 makeup_a, makeup_b, makeup_c, down_a, down_b, down_c;
+        i32 attack;
+        const i32* release;
+    };
+
+    struct Band {
+        i64 envelope = 0; // stereo mean power, Q44
+        i64 gain_envelope = 0;
+        i32 gain = 0, step = 0;
+    };
+
+public:
+    void reset() { *this = Processor{}; }
+    void reset_signal() {
+        const i32 correction = match_db_;
+        reset();
+        match_db_ = correction;
+    }
+    bool settled() const { return silent_blocks_ >= tail_blocks; }
+
+    void process(i32* sum, const Controls& controls) {
+        const bool matching = controls.level_match != 0;
+        const bool lean = controls.character == Mix;
+        bool silent = true;
+        bool mono = !stereo_seen_;
+        const bool force_mono = controls.focus == Mono;
+        i64 dry_power = 0;
+        for (u32 frame = 0; frame < opxy::block_frames; ++frame) {
+            if (force_mono) {
+                const i32 mean = static_cast<i32>((static_cast<i64>(sum[2 * frame]) + sum[2 * frame + 1]) >> 1);
+                sum[2 * frame] = sum[2 * frame + 1] = mean;
+            }
+            const i32 left = sum[2 * frame], right = sum[2 * frame + 1];
+            mono = mono && left == right;
+            silent = silent && left == 0 && right == 0;
+            if (matching && (!lean || (frame & 1) == meter_parity_))
+                dry_power += meter_square(left >> 16) + meter_square(right >> 16);
+        }
+        if (!silent) silent_blocks_ = 0;
+        else if (++silent_blocks_ >= tail_blocks) {
+            for (u32 i = 0; i < 2 * opxy::block_frames; ++i) sum[i] = 0;
+            return;
+        }
+        update_crossover(controls.crossover);
+        if ((mono && controls.focus != Side) || force_mono) {
+            if (force_mono && stereo_seen_) split_[0].fold(split_[1]);
+            stereo_seen_ = false;
+            if (lean) process_channels<1, true>(sum, controls, dry_power);
+            else process_channels<1, false>(sum, controls, dry_power);
+            meter_parity_ ^= 1;
+            return;
+        }
+        if (!stereo_seen_) {
+            // Restore the other channel's filter history when the input first
+            // differs. Resume mono only after both channels reset together.
+            split_[1] = split_[0];
+            stereo_seen_ = true;
+        }
+        if (lean) process_channels<2, true>(sum, controls, dry_power);
+        else process_channels<2, false>(sum, controls, dry_power);
+        meter_parity_ ^= 1;
+    }
+
+private:
+    template <u32 channels, bool lean>
+    void process_channels(i32* sum, const Controls& controls, i64 dry_power) {
+        static constexpr Curve curves[] = {
+            {-3015777,-2551978,3618,32768,1187246,131072,49012,919785,2352808,-1720975,
+             120468,-79576,24645,63248,2067,221,15274,faust_tables::release_low_q22},
+            {-3053224,-2281990,29550,34736,145345,123647,49546,593234,2377974,-2077491,
+             107381,-54542,12696,63020,1445,1071,15822,faust_tables::release_mid_q22},
+            {-3108982,-2732058,2215,32768,1938935,131072,48980,921698,2350907,-1700659,
+             120875,-80428,25090,63757,3787,-2008,9836,faust_tables::release_high_q22},
+        };
+        const i32 depth = lean ? controls.depth - controls.depth / 4 : controls.depth;
+        const i32 gain_period = lean || controls.character == Pad ? 8 : 4;
+        const bool focus = channels == 2 && (controls.focus == Mid || controls.focus == Side);
+        const bool side = controls.focus == Side;
+        const i32 added_db = match_db_ - q31::multiply(depth, 6 * db_unit);
+        const i32 protected_depth = controls.low_protect ? q31::multiply(depth, q31::maximum - controls.low_protect) : depth;
+        const i32 trims[] = {trim_db(controls.low_trim) + match_db_ - q31::multiply(protected_depth, 6 * db_unit),
+                             added_db, trim_db(controls.high_trim) + added_db};
+        i32 rise[3], fall[3], fixed_db[3], attack[3], release[3];
+        i64 first_power[3] = {};
+        const i32 downward = down_strength(controls.downward);
+        for (u32 band = 0; band < 3; ++band) {
+            const auto& curve = curves[band];
+            const i32 band_depth = band == 0 ? protected_depth : depth;
+            const i32 makeup = depth_curve(band_depth, curve.makeup_a, curve.makeup_b, curve.makeup_c);
+            const i32 down = depth_curve(band_depth, curve.down_a, curve.down_b, curve.down_c);
+            rise[band] = q31::multiply(band_depth, q31::multiply(controls.upward, 2 * curve.up_slope));
+            fall[band] = min(db_unit, mul_q16(down, downward));
+            fixed_db[band] = mul_q16(makeup, curve.makeup);
+            const i32 decay = lookup_control(curve.release, controls.time, 6);
+            attack[band] = lean ? pair_coefficient(curve.attack) : curve.attack;
+            release[band] = lean ? pair_coefficient(decay) : decay;
+        }
+
+        i64 peak = 0;
+        i64 wet_power = 0;
+        // Ignore blocks below approximately -60 dBFS RMS, including tails.
+        const bool matching = controls.level_match != 0;
+        const bool meter_active = matching && dry_power >= (lean ? 69000 : 138000);
+        i64 output[2 * opxy::block_frames];
+        for (u32 frame = 0; frame < opxy::block_frames; ++frame) {
+            i32 stereo[2][3];
+            for (u32 ch = 0; ch < channels; ++ch)
+                split_[ch].tick(q31::shift_right(sum[2 * frame + ch], 3), stereo[ch], upper_);
+
+            i64 wet[2] = {};
+            for (u32 band = 0; band < 3; ++band) {
+                auto& state = bands_[band];
+                const auto& curve = curves[band];
+                const i64 left_power = square(stereo[0][band]);
+                const i32 selected = focus ? static_cast<i32>((static_cast<i64>(stereo[0][band]) +
+                    (side ? -static_cast<i64>(stereo[1][band]) : stereo[1][band])) >> 1) : 0;
+                const i64 power = focus ? square(selected) >> 12 : channels == 1 ? left_power >> 12
+                    : (left_power + square(stereo[1][band])) >> 13;
+                // Mix integrates both samples of the pair with the equivalent
+                // two-sample time constant. Audio and crossover stay full rate.
+                if (!lean || (frame & 1)) {
+                    const i64 measured = lean ? (power + first_power[band]) >> 1 : power;
+                    const i64 delta = measured - state.envelope;
+                    const i32 coefficient = delta > 0 ? attack[band] : release[band];
+                    const i32 whole = static_cast<i32>(delta >> 22);
+                    const i32 fraction = static_cast<i32>(delta) & ((1 << 22) - 1);
+                    state.envelope += q31::wide(whole, coefficient) +
+                        (q31::wide(fraction, coefficient) >> 22);
+                } else {
+                    first_power[band] = power;
+                }
+                if (!(frame & (gain_period - 1))) {
+                    // Recompute at each block boundary so knob and Level Match
+                    // changes apply immediately. Within the block, a 1/32
+                    // change in envelope power is about 0.14 dB.
+                    const i64 difference = state.envelope - state.gain_envelope;
+                    const i64 tolerance = state.gain_envelope >> 5;
+                    if (!frame || difference < -tolerance || difference > tolerance) {
+                        state.gain_envelope = state.envelope;
+                        const i32 db = level_db(state.envelope);
+                        const i32 up = mul_q16(rise[band],
+                            soft_hinge(curve.up_threshold - db, curve.up_width, curve.inv_up_width));
+                        const i32 down = mul_q16(fall[band],
+                            soft_hinge(db - curve.down_threshold, curve.down_width, curve.inv_down_width));
+                        const i32 gain_db = max(curve.floor, fixed_db[band] + min(curve.cap, up) - down) +
+                            trims[band];
+                        const i32 next = gain_linear(gain_db);
+                        if (!initialized_ && frame == 0) state.gain = next;
+                        const i32 change = next - state.gain;
+                        state.step = gain_period == 8 ? change / 8 : change / 4;
+                    } else {
+                        state.step = 0;
+                    }
+                }
+                state.gain += state.step;
+                if (focus) {
+                    // Preserve the other component with the same crossover phase.
+                    const i64 delta = (q31::wide(selected, state.gain) >> 22) - (selected >> 3);
+                    wet[0] += (stereo[0][band] >> 3) + delta;
+                    wet[1] += (stereo[1][band] >> 3) + (side ? -delta : delta);
+                } else {
+                    for (u32 ch = 0; ch < channels; ++ch)
+                        wet[ch] += q31::wide(stereo[ch][band], state.gain) >> 22;
+                }
+            }
+            for (u32 ch = 0; ch < channels; ++ch) {
+                const i64 sample = wet[ch];
+                output[2 * frame + ch] = sample;
+                if (meter_active && (!lean || (frame & 1) == meter_parity_))
+                    wet_power += (channels == 1 ? 2 : 1) * meter_square(sample >> 10);
+                const i64 magnitude = sample < 0 ? -sample : sample;
+                if (magnitude > peak) peak = magnitude;
+            }
+        }
+        initialized_ = true;
+        const i32 limit = peak_limit(peak);
+        if (limiter_ < limit) limiter_ += (limit - limiter_) / 4 + 1;
+        else limiter_ = limit;
+        if (lean && meter_active && limiter_ < q31::maximum) {
+            const i32 gain = limiter_ >> 16;
+            const i32 power_gain = (gain * gain) >> 15;
+            const i32 low = static_cast<i32>(wet_power) & 32767;
+            wet_power = q31::wide(static_cast<i32>(wet_power >> 15), power_gain) +
+                        (q31::wide(low, power_gain) >> 15);
+        }
+        update_level_match(matching, meter_active, dry_power, wet_power, lean, limiter_ < q31::maximum);
+        for (u32 frame = 0; frame < opxy::block_frames; ++frame) {
+            for (u32 ch = 0; ch < channels; ++ch)
+                sum[2 * frame + ch] = q31::shift_left(apply_limit(output[2 * frame + ch], limiter_), 6);
+            if (channels == 1) sum[2 * frame + 1] = sum[2 * frame];
+        }
+    }
+
+    static constexpr u32 tail_blocks = 128;
+    Split split_[2];
+    Coefficients upper_{}, upper_target_{};
+    i32 crossover_value_ = -1;
+    Band bands_[3];
+    u32 silent_blocks_ = 0;
+    bool stereo_seen_ = false;
+    bool initialized_ = false;
+    i32 limiter_ = q31::maximum;
+    i32 match_db_ = 0;
+    u32 metered_blocks_ = 0, limited_blocks_ = 0, meter_parity_ = 0;
+    i64 dry_meter_ = 0, wet_meter_ = 0;
+
+    void update_crossover(i32 value) {
+        static constexpr Coefficients table[] = {
+            {153241600, 205831576, 138553731},
+            {171913037, 229438324, 153545754},
+            {192881213, 255574278, 169926218},
+            {216437611, 284467224, 187767122},
+            {242914398, 316355158, 207129621},
+            {272691594, 351484203, 228059456},
+            {306206086, 390105831, 250581551},
+            {343963121, 432473373, 274693727},
+            {386551232, 478837775, 300359502},
+            {441034953, 536007777, 330953480},
+            {503675124, 598857507, 363217883},
+            {575925858, 667681783, 396862700},
+            {659614139, 742734035, 431478353},
+            {757088165, 824217000, 466513223},
+            {871447840, 912275716, 501246790},
+            {1006915555, 1006993896, 534754653},
+            {1169457264, 1108394012, 565858057},
+        };
+        if (value != crossover_value_) {
+            crossover_value_ = value;
+            const u32 segment = static_cast<u32>(value) >> 27;
+            const i32 fraction = (value & ((1 << 27) - 1)) * 16;
+            const auto& a = table[segment];
+            const auto& b = table[segment + 1];
+            if (value == q31::maximum / 2) upper_target_ = table[8];
+            else upper_target_ = {
+                a.g_q31 + q31::multiply(b.g_q31 - a.g_q31, fraction),
+                a.damping_q31 + q31::multiply(b.damping_q31 - a.damping_q31, fraction),
+                a.input_q31 + q31::multiply(b.input_q31 - a.input_q31, fraction)
+            };
+        }
+        const auto update = [&](i32 current, i32 target) {
+            const i32 delta = target - current;
+            return !initialized_ || (delta >= -8 && delta <= 8) ? target : current + delta / 8;
+        };
+        upper_.g_q31 = update(upper_.g_q31, upper_target_.g_q31);
+        upper_.damping_q31 = update(upper_.damping_q31, upper_target_.damping_q31);
+        upper_.input_q31 = update(upper_.input_q31, upper_target_.input_q31);
+    }
+
+    static i32 pair_coefficient(i32 single) {
+        return 2 * single - static_cast<i32>(q31::wide(single, single) >> 22);
+    }
+
+    static i64 meter_square(i64 sample) {
+        constexpr i32 bound = 8 << 15;
+        const i32 value = sample > bound ? bound : sample < -bound ? -bound : static_cast<i32>(sample);
+        return q31::wide(value, value);
+    }
+
+    void update_level_match(bool matching, bool active, i64 dry, i64 wet, bool lean, bool limiting) {
+        if (!matching) {
+            metered_blocks_ = limited_blocks_ = 0;
+            dry_meter_ = wet_meter_ = 0;
+            // Ramp back to the uncorrected Faust gain without an audible jump.
+            match_db_ += max(-1024, min(1024, -match_db_));
+            return;
+        }
+        if (!active) return;
+        dry_meter_ += dry;
+        wet_meter_ += wet;
+        if (limiting) ++limited_blocks_;
+        if (++metered_blocks_ < 16) return;
+        if (wet_meter_) {
+            // The reference and processed energy have the same units, so
+            // their dB difference needs no calibration for meter window size.
+            // Reuse the band gain stages for correction before the limiter.
+            const i32 limit = lean ? db_unit / 4 : db_unit / 8;
+            const i32 error = level_db(dry_meter_) - level_db(wet_meter_);
+            const i32 offset = lean ? error / 4 : q31::multiply(error, 178956971);
+            const i32 step = max(-limit, min(limit, offset));
+            // The limiter already used the available peak headroom. Avoid
+            // accumulating gain that will only hit it harder.
+            if (!lean || step <= 0 || limited_blocks_ < 4)
+                match_db_ = max(-12 * db_unit, min(12 * db_unit, match_db_ + step));
+        }
+        metered_blocks_ = limited_blocks_ = 0;
+        dry_meter_ = wet_meter_ = 0;
+    }
+
+    static i32 min(i32 a, i32 b) { return a < b ? a : b; }
+    static i32 max(i32 a, i32 b) { return a > b ? a : b; }
+    static i32 mul_q16(i32 a, i32 b) { return static_cast<i32>(q31::wide(a, b) >> 16); }
+    static i32 rounded(i32 coefficient, i32 sample) {
+        return static_cast<i32>((q31::wide(coefficient, sample) + (1 << 30)) >> 31);
+    }
+    static i64 square(i32 x) {
+        constexpr i32 bound = 4 << 28;
+        x = min(bound, max(-bound, x));
+        return q31::wide(x, x);
+    }
+    static i32 trim_db(i32 value) {
+        return q31::multiply(value - q31::maximum / 2, 24 * db_unit);
+    }
+    static i32 depth_curve(i32 depth, i32 a, i32 b, i32 c) {
+        return q31::multiply(depth, a + q31::multiply(depth, b + q31::multiply(depth, c)));
+    }
+    static i32 lookup_control(const i32* table, i32 value, u32 bits) {
+        const u32 index = static_cast<u32>(value) >> (31 - bits);
+        const i32 fraction = (value & (q31::maximum >> bits)) << bits;
+        return table[index] + q31::multiply(table[index + 1] - table[index], fraction);
+    }
+    static i32 down_strength(i32 value) {
+        // Upstream's fitted curve below 1, then a straight line up to 2.
+        if (value >= q31::maximum / 2) return value >> 14;
+        constexpr i32 points[] = {0, 12433, 25517, 38669, 51978, 65536, 65536};
+        const u32 step = static_cast<u32>(value >> 15) * 10;
+        const u32 index = step >> 16;
+        return points[index] + mul_q16(points[index + 1] - points[index], step & 65535u);
+    }
+    static i32 soft_hinge(i32 value, i32 width, i32 inverse) {
+        const i32 distance = value < 0 ? -value : value;
+        const i32 positive = max(0, value);
+        if (distance >= 8 * width) return positive;
+        const i32 position = 4 * mul_q16(distance, inverse);
+        const u32 index = static_cast<u32>(position) >> 16;
+        if (index >= 32) return positive;
+        const auto* table = faust_tables::softplus_q16;
+        return positive + mul_q16(width, table[index] + mul_q16(table[index + 1] - table[index], position & 65535));
+    }
+    static i32 level_db(i64 energy) {
+        if (!energy) return -200 * db_unit;
+        const u32 hi = static_cast<u32>(energy >> 32);
+        const u32 word = hi ? hi : static_cast<u32>(energy);
+        const u32 shift = leading_zeros(word);
+        const u32 low = static_cast<u32>(energy);
+        const u32 normalized = hi ? (hi << shift) | (low >> (32 - shift)) : low << shift;
+        const u32 index = (normalized >> 26) & 31u;
+        const i32 fraction = (normalized >> 10) & 65535u;
+        const auto* table = faust_tables::log2_q16;
+        const i32 octave = (hi ? 63 : 31) - static_cast<i32>(shift) - 44;
+        return mul_q16(197283, octave * db_unit + table[index] +
+                       mul_q16(table[index + 1] - table[index], fraction));
+    }
+    static u32 leading_zeros(u32 word) {
+#if defined(__bfin__)
+        // The unsigned shift inserts a leading sign bit. SIGNBITS counts
+        // the remaining leading zeros, including the word == 1 case.
+        u32 result;
+        const u32 positive = word >> 1;
+        __asm__("%0.L = SIGNBITS %1;\n\t%0 = %0.L (Z);"
+                : "=d"(result) : "d"(positive) : "ASTAT");
+        return result;
+#else
+        return static_cast<u32>(__builtin_clz(word));
+#endif
+    }
+    static i32 gain_linear(i32 db) {
+        const i32 octave = mul_q16(db, 10885);
+        const i32 shift = q31::shift_right(octave, 16);
+        const u32 fraction = static_cast<u32>(octave) & 65535u;
+        const u32 index = fraction >> 11;
+        const auto* table = faust_tables::exp2_q20;
+        const i32 gain = (table[index] +
+            mul_q16(table[index + 1] - table[index], (fraction & 2047u) << 5)) >> 1; // Q19
+        return shift < 0 ? q31::shift_right(gain, -shift) : q31::shift_left(gain, shift);
+    }
+    static i32 peak_limit(i64 peak) {
+        constexpr i32 ceiling = 29905418; // -1 dBFS in Q25
+        if (peak <= ceiling) return q31::maximum;
+        i64 remainder = ceiling;
+        u32 gain = 0;
+        for (u32 bit = 0; bit < 23; ++bit) {
+            remainder <<= 1;
+            gain <<= 1;
+            if (remainder >= peak) {
+                remainder -= peak;
+                ++gain;
+            }
+        }
+        return static_cast<i32>(gain << 8);
+    }
+    static i32 apply_limit(i64 sample, i32 gain) {
+        if (gain == q31::maximum) return static_cast<i32>(sample);
+        if (sample <= q31::maximum && sample >= q31::minimum)
+            return q31::multiply(static_cast<i32>(sample), gain);
+        // Keep overloads in wide precision until after the shared gain.
+        const i64 upper = q31::wide(static_cast<i32>(sample >> 16), gain);
+        const i64 lower = q31::wide(static_cast<i32>(sample & 65535), gain);
+        return static_cast<i32>((upper + (lower >> 16)) >> 15);
+    }
+};
+
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp b/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp
new file mode 100644
index 0000000..406b667
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp
@@ -0,0 +1,85 @@
+#pragma once
+
+#include "ott.hpp"
+
+namespace ott {
+
+// Track indices are zero-based. The SDK adapter owns project settings and
+// hands a complete snapshot to configure() on the audio role.
+struct TrackSettings {
+    constexpr TrackSettings(Controls config = {}) : controls(config) {}
+    bool enabled = false;
+    Controls controls;
+};
+
+class TrackInserts {
+public:
+    static constexpr u32 track_count = 8;
+    static constexpr u32 insert_limit = 4;
+
+    // Apply a complete validated snapshot at a block boundary. Reject a fifth
+    // enabled insert without changing any track's settings or audio state.
+    bool configure(const TrackSettings (&settings)[track_count]) {
+        u32 enabled = 0;
+        for (const auto& config : settings) {
+            if (config.enabled) ++enabled;
+        }
+        if (enabled > insert_limit) return false;
+        for (u32 index = 0; index < track_count; ++index) {
+            auto& track = tracks_[index];
+            if (settings[index].controls.level_match != track.settings.controls.level_match &&
+                (!track.active || !settings[index].enabled))
+                track.reset();
+            else if (!settings[index].enabled && track.settings.enabled)
+                track.sleep();
+            track.settings = settings[index];
+        }
+        return true;
+    }
+
+    // Called on the audio role after project activation, before its first block.
+    void reset() {
+        for (auto& track : tracks_) track.reset();
+    }
+
+    bool needs_tail(u32 index) const { return index < track_count && tracks_[index].active; }
+
+    // Called on the audio role when the mixer has finished summing one track.
+    // The returned count keeps the mixer's tail path open when needed.
+    u32 process(u32 index, i32* sum, u32 voices) {
+        if (index >= track_count) return voices;
+        auto& track = tracks_[index];
+        const auto& settings = track.settings;
+        if (!settings.enabled) return voices;
+        if (!track.active && !voices) return 0;
+        track.active = true;
+        track.processor.process(sum, settings.controls);
+        if (voices) return voices;
+        for (u32 word = 0; word < 2 * opxy::block_frames; ++word) {
+            if (sum[word]) return 1;
+        }
+        if (track.processor.settled()) track.sleep();
+        return 0;
+    }
+
+private:
+    struct Track {
+        TrackSettings settings;
+        Processor processor;
+        bool active = false;
+
+        void sleep() {
+            if (settings.controls.level_match) processor.reset_signal();
+            else processor.reset();
+            active = false;
+        }
+
+        void reset() {
+            processor.reset();
+            active = false;
+        }
+    };
+    Track tracks_[track_count];
+};
+
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_hooks.s b/sdk/platform/opxy-1.2.1/ott_hooks.s
new file mode 100644
index 0000000..1328095
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_hooks.s
@@ -0,0 +1,97 @@
+.section .text
+.align 2
+
+.macro resume name, high, low
+    P0.H = \high;
+    P0.L = \low;
+    JUMP (P0);
+.size \name, .-\name
+.endm
+
+.global sdk_ott_stock_buttons
+.type sdk_ott_stock_buttons, STT_FUNC
+sdk_ott_stock_buttons:
+    LINK 0;
+    [--SP] = (R7:4, P5:3);
+    SP += -20;
+    resume sdk_ott_stock_buttons, 0x8c0b, 0x2e54
+
+.extern sdk_ott_dispatch_shift
+.global sdk_ott_shifted_key
+.type sdk_ott_shifted_key, STT_FUNC
+sdk_ott_shifted_key:
+    LINK 12;
+    CALL sdk_ott_dispatch_shift;
+    UNLINK;
+    CC = R0 == 0;
+    RTS;
+.size sdk_ott_shifted_key, .-sdk_ott_shifted_key
+
+.global sdk_ott_stock_turn
+.type sdk_ott_stock_turn, STT_FUNC
+sdk_ott_stock_turn:
+    LINK 68;
+    [--SP] = (R7:4, P5:3);
+    SP += -20;
+    resume sdk_ott_stock_turn, 0x8c0b, 0x12ec
+
+.global sdk_ott_stock_draw
+.type sdk_ott_stock_draw, STT_FUNC
+sdk_ott_stock_draw:
+    LINK 48;
+    [--SP] = (R7:5, P5:3);
+    P5 = R0;
+    resume sdk_ott_stock_draw, 0x8d51, 0xfe24
+
+.global sdk_ott_stock_off_popup
+.type sdk_ott_stock_off_popup, STT_FUNC
+sdk_ott_stock_off_popup:
+    LINK 16;
+    resume sdk_ott_stock_off_popup, 0x8d53, 0xa6ac
+
+/* MIX OTT stock trampolines */
+/* Entry trampolines replay exactly the eight bytes redirected in stock 1.2.1.
+ * Their C++ callers use ordinary ABI calls; stock epilogues return to them.
+ * P0 is caller-saved and is not live at these entry continuations.
+ */
+.section .text
+.align 2
+.global sdk_master_stock_buttons
+.type sdk_master_stock_buttons, STT_FUNC
+sdk_master_stock_buttons:
+    LINK 0;
+    [--SP] = (R7:5, P5:3);
+    P4 = R1;
+    P0.H = 0x8c09; P0.L = 0x3a78;
+    JUMP (P0);
+.size sdk_master_stock_buttons, .-sdk_master_stock_buttons
+
+.global sdk_master_stock_shift_buttons
+.type sdk_master_stock_shift_buttons, STT_FUNC
+sdk_master_stock_shift_buttons:
+    P1 = R1;
+    LINK 12;
+    R1 = 12;
+    P0.H = 0x8c09; P0.L = 0x3934;
+    JUMP (P0);
+.size sdk_master_stock_shift_buttons, .-sdk_master_stock_shift_buttons
+
+.global sdk_master_stock_turn
+.type sdk_master_stock_turn, STT_FUNC
+sdk_master_stock_turn:
+    R3 = 8;
+    CC = R1 < R3 (IU);
+    LINK 12;
+    P0.H = 0x8c09; P0.L = 0x3890;
+    JUMP (P0);
+.size sdk_master_stock_turn, .-sdk_master_stock_turn
+
+.global sdk_master_stock_frame
+.type sdk_master_stock_frame, STT_FUNC
+sdk_master_stock_frame:
+    LINK 144;
+    [--SP] = (R7:4, P5:3);
+    SP += -20;
+    P0.H = 0x8d53; P0.L = 0x7d0c;
+    JUMP (P0);
+.size sdk_master_stock_frame, .-sdk_master_stock_frame
diff --git a/sdk/platform/opxy-1.2.1/ott_insert.cpp b/sdk/platform/opxy-1.2.1/ott_insert.cpp
new file mode 100644
index 0000000..341c849
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_insert.cpp
@@ -0,0 +1,320 @@
+#include "ott_filter/firmware_runtime.hpp"
+#include "ott_project.hpp"
+#include "opxy/draw.hpp"
+#include "retained_drawing.hpp"
+
+using opxy::i32;
+using opxy::u32;
+using opxy::platform::stock;
+using namespace opxy::screen;
+
+extern "C" {
+void sdk_drum_send_begin() __asm__("sdk_drum_send_begin");
+u32 sdk_ott_stock_buttons(void*, const u32*) __asm__("sdk_ott_stock_buttons");
+void sdk_ott_stock_turn(void*, u32, const i32*) __asm__("sdk_ott_stock_turn");
+void sdk_ott_stock_draw(Base*, u32) __asm__("sdk_ott_stock_draw");
+void sdk_ott_stock_off_popup(void*, i32) __asm__("sdk_ott_stock_off_popup");
+u32 sdk_ott_buttons(void*, const u32*) __asm__("sdk_ott_buttons");
+u32 sdk_ott_dispatch_shift(void*, const u32*) __asm__("sdk_ott_dispatch_shift");
+void sdk_ott_turn(void*, u32, const i32*) __asm__("sdk_ott_turn");
+void sdk_ott_draw(Base*, u32) __asm__("sdk_ott_draw");
+void sdk_ott_off_popup(void*, i32) __asm__("sdk_ott_off_popup");
+u32 sdk_ott_voices(void*, u32, i32*) __asm__("sdk_ott_voices");
+void sdk_ott_filter(void*, u32, void*) __asm__("sdk_ott_filter");
+void sdk_ott_receive(u32, u32, i32) __asm__("sdk_ott_receive");
+u32 sdk_ott_activate() __asm__("sdk_ott_activate");
+u32 sdk_master_buttons(void*, const u32*) __asm__("sdk_master_buttons");
+u32 sdk_master_shift_buttons(void*, const u32*) __asm__("sdk_master_shift_buttons");
+void sdk_master_turn(void*, u32, const i32*) __asm__("sdk_master_turn");
+void sdk_master_frame(void*, i32) __asm__("sdk_master_frame");
+void sdk_master_process(void*, i32*, i32*) __asm__("sdk_master_process");
+u32 sdk_master_stock_buttons(void*, const u32*) __asm__("sdk_master_stock_buttons");
+u32 sdk_master_stock_shift_buttons(void*, const u32*) __asm__("sdk_master_stock_shift_buttons");
+void sdk_master_stock_turn(void*, u32, const i32*) __asm__("sdk_master_stock_turn");
+void sdk_master_stock_frame(void*, i32) __asm__("sdk_master_stock_frame");
+}
+
+namespace {
+constexpr u32 kInstrumentPage = 0x080238bc;
+constexpr u32 kEnvelopePage = 1;
+constexpr u32 kInstrumentController = 0x8400dff8;
+constexpr u32 kTrackSum = 0x11903600;
+ott::DeviceControls controls{};
+ott::AudioInsert audio{};
+ott::ProjectSettings pending_project{};
+u32 current_project, loading_project, sequence, voices;
+bool limit_hit;
+void* active_mixer;
+
+void publish(u32 selection, bool reset) {
+    const auto send = [](u32 id, i32 value) { stock<void(u32, i32)>(0x8d4dc84c)(id, value); };
+    ott::publish(controls.project(), selection, reset, ++sequence, send);
+    if (!selection) ott::publish(controls.project(), ott::mix_index + 1, reset, ++sequence, send);
+}
+
+bool instrument_is_top() {
+    const u32* controller = stock<const u32*()>(0x8c0944b0)();
+    return controller && *controller == kInstrumentController;
+}
+
+u32 select() {
+    const u32 track = opxy::platform::selected_track();
+    controls.select(track, opxy::platform::word(kInstrumentPage) == kEnvelopePage ? ott::Page::envelope : ott::Page::other);
+    if (track < ott::TrackInserts::track_count) active_mixer = nullptr;
+    return track;
+}
+
+i32 dial(const i32* event) {
+    if (!event[0]) return 0;
+    const auto count = event[1] < 0 ? -static_cast<opxy::i64>(event[1]) : event[1];
+    const i32 detents = count < 1 ? 1 : count > 8 ? 8 : static_cast<i32>(count);
+    return event[0] < 0 ? -detents : detents;
+}
+
+bool handled(ott::InputResult result, u32 track) {
+    if (result == ott::InputResult::stock) return false;
+    limit_hit = result == ott::InputResult::insert_limit;
+    if (result == ott::InputResult::settings_changed) publish(track + 1, false);
+    return true;
+}
+
+using Display = opxy::draw::Frame<0, 0, 5, 17, 1>;
+using Renderer = RetainedDrawing<Display>;
+using Object = Renderer::Object;
+Object object{};
+Display display{};
+bool constructed, bound;
+const char* const ids[] = {
+    "ott_marker1", "ott_marker2", "ott_marker3", "ott_marker4", "ott_popup",
+    "ott_title", "ott_status", "ott_help",
+    "primary1", "primary2", "primary3", "primary4",
+    "primary_dim1", "primary_dim2", "primary_dim3", "primary_dim4",
+    "secondary1", "secondary2", "secondary3",
+    "secondary_dim1", "secondary_dim2", "secondary_dim3",
+    "ott_marker1"
+};
+
+void bind(Object* o) {
+    clear(o);
+    if (o->base.svg) Renderer::bind(o, ids);
+}
+void unused_frame(Object*, i32) {}
+const VTable<Renderer> methods = {destroy<Object>, destroy<Object>, reinterpret_cast<const void*>(0x8d51fcd4),
+                                  unused_frame, bind, reinterpret_cast<const void*>(0x8c0867f0)};
+
+void line(u32 slot, i32 x, i32 y, const char* text) {
+    auto& entry = display.texts[slot];
+    entry.x = x * 1024;
+    entry.y = y * 1024;
+    entry.scale = 1024;
+    u32 i = 0;
+    while (text[i] && i + 1 < sizeof entry.chars) {
+        entry.chars[i] = text[i];
+        ++i;
+    }
+    entry.chars[i] = 0;
+}
+
+bool draw_panel(const ott::Panel& panel) {
+    if (!constructed) {
+        base_construct(&object.base, 0, "ott_filter.svg");
+        object.base.vtable = &methods;
+        constructed = true;
+    }
+    if (!bound) {
+        if (!object.base.svg) stock<void(Base*)>(0x8d520ce0)(&object.base);
+        if (!object.base.svg) return false;
+        bind(&object);
+        bound = true;
+    }
+    char title[] = "OTT   TRACK 1";
+    title[12] = static_cast<char>('0' + panel.track_number);
+    char status[] = "0/4 ACTIVE  OTT BYPASS";
+    status[0] = static_cast<char>('0' + panel.enabled_count);
+    if (panel.enabled) {
+        status[16] = 'O';
+        status[17] = 'N';
+        status[18] = 0;
+    }
+    line(0, 14, 30, panel.track_number ? title : "OTT   MIX");
+    opxy::draw::place(display, 4, panel.shifted ? 0 : 500*1024, 0, 1024, 0, opxy::draw::keep);
+    line(1, 14, 59, panel.track_number ? status : panel.enabled ? "MIX ON" : "MIX BYPASS");
+    line(2, 14, 204, limit_hit ? "Four-track limit" :
+        panel.shifted ? "OTT OPTIONS" : "White: On/Off | Shift: Options");
+    for (u32 i = 0; i < 4; ++i) {
+        const i32 x = 14 + static_cast<i32>(i) * 117;
+        const bool alternate = panel.alternate[i];
+        line(3 + i, x, panel.shifted ? 105 : 92,
+            panel.shifted ? panel.encoders[i].label : alternate ? "" : panel.primary[i].label);
+        line(7 + i, x, 92, alternate ? panel.primary[i].label : "");
+        if (i < 3) {
+            const char* label = i == 0 ? (panel.secondary[i].value ? "Match Auto" : "Match Off") :
+                panel.secondary[i].label;
+            line(11 + i, x, 150, !panel.shifted && alternate ? label : "");
+            line(14 + i, x, 150, !panel.shifted && !alternate ? label : "");
+        }
+        const i32 offset = ((panel.encoders[i].value >> 24) * 95) >> 7;
+        const i32 y = panel.shifted ? 132 : alternate ? 171 : 112;
+        opxy::draw::place(display, i, (x + 3 + offset) * 1024, y * 1024, 1024, 0, opxy::draw::keep);
+    }
+    Renderer::apply(&object, display);
+    sdk_ott_stock_draw(&object.base, 0);
+    return true;
+}
+}
+
+u32 sdk_ott_buttons(void* controller, const u32* event) {
+    if (controller && event) {
+        const u32 track = select();
+        const u32 key = event[0];
+        if (key >= 6 && key <= 9 && !stock<u32()>(0x8d5b7e34)() &&
+            handled(controls.module(key - 5, false), track)) return 1;
+        if (key >= 10 && key <= 13 &&
+            handled(controls.click(key - 10, opxy::platform::shift_held()), track)) return 1;
+    }
+    return sdk_ott_stock_buttons(controller, event);
+}
+
+u32 sdk_ott_dispatch_shift(void* controller, const u32* event) {
+    if (!controller) return 0;
+    const auto* methods = *static_cast<const u32* const*>(controller);
+    if (!methods) return 0;
+    if (reinterpret_cast<u32>(methods) == kInstrumentController && event) {
+        const u32 track = select();
+        const u32 key = event[0];
+        if (key >= 6 && key <= 9) controls.module(key - 5, true);
+        if (key >= 10 && key <= 13 && handled(controls.click(key - 10, true), track)) return 1;
+    }
+    return stock<u32(void*, const u32*)>(methods[4])(controller, event);
+}
+
+void sdk_ott_turn(void* controller, u32 position, const i32* event) {
+    if (controller && event && position < 8) {
+        const u32 track = select();
+        if (handled(controls.turn(position & 3, opxy::platform::shift_held(), dial(event), 0), track)) return;
+    }
+    sdk_ott_stock_turn(controller, position, event);
+}
+
+void sdk_ott_draw(Base* screen, u32 flags) {
+    // The M2 screen ID varies with the engine and the Shift layer. Replace
+    // only the screen selected by the stock instrument controller.
+    if (screen && opxy::platform::word(kInstrumentPage) == kEnvelopePage &&
+        controls.page() == ott::Page::ott && instrument_is_top()) {
+        const u32 selected_screen = stock<u32()>(0x8c0b1198)();
+        if (screen->page == selected_screen) {
+            select();
+            ott::Panel panel{};
+            if (controls.panel(panel, opxy::platform::shift_held()) && draw_panel(panel)) return;
+        }
+    }
+    sdk_ott_stock_draw(screen, flags);
+}
+
+void sdk_ott_off_popup(void* frame, i32 elapsed) {
+    // Stock composites off_popup.svg after the Filter page and dims every
+    // existing pixel first. It belongs to the stock view. Filter and its sends stay on M3.
+    if (bound && instrument_is_top() && opxy::platform::word(kInstrumentPage) == kEnvelopePage &&
+        controls.page() == ott::Page::ott)
+        return;
+    sdk_ott_stock_off_popup(frame, elapsed);
+}
+
+u32 sdk_ott_voices(void* manager, u32 track, i32* sum) {
+    audio.start_track(track);
+    sdk_drum_send_begin();
+    voices = stock<u32(void*, u32, i32*)>(0x8d51c708)(manager, track, sum);
+    return voices ? voices : audio.needs_tail(track);
+}
+
+void sdk_ott_filter(void* context, u32 track, void* params) {
+    stock<void(void*, u32, void*)>(0x8d51020c)(context, track, params);
+    audio.process(track, reinterpret_cast<i32*>(kTrackSum), voices);
+}
+
+void sdk_ott_receive(u32 base, u32 id, i32 value) {
+    if (!audio.receive(id, value)) stock<void(u32, u32, i32)>(0x8d50eb8c)(base, id, value);
+}
+
+namespace {
+bool on_mix_eq(const void* controller) {
+    return controller && static_cast<const u32*>(controller)[0x88 / 4] == 1;
+}
+bool mix_open() {
+    return active_mixer && stock<void*()>(0x8c0944b0)() == active_mixer &&
+        on_mix_eq(active_mixer) && controls.is_mix() && controls.page() == ott::Page::ott;
+}
+}
+
+u32 sdk_master_buttons(void* controller, const u32* event) {
+    if (controller && event) {
+        const u32 key = event[0];
+        controls.select_mix(on_mix_eq(controller));
+        if (key == 7 && on_mix_eq(controller)) {
+            active_mixer = controller;
+            controls.module(2, false);
+            limit_hit = false;
+            return 1;
+        }
+        if (key >= 10 && key <= 13 && mix_open() &&
+            handled(controls.click(key - 10, false), ott::mix_index)) return 1;
+        if (key >= 6 && key <= 9) {
+            controls.module(key - 5, false);
+            active_mixer = nullptr;
+        }
+    }
+    return sdk_master_stock_buttons(controller, event);
+}
+
+u32 sdk_master_shift_buttons(void* controller, const u32* event) {
+    if (controller && event && mix_open() && event[0] >= 10 && event[0] <= 13) return 1;
+    return sdk_master_stock_shift_buttons(controller, event);
+}
+
+void sdk_master_turn(void* controller, u32 position, const i32* event) {
+    if (event && position < 8 && mix_open() &&
+        handled(controls.turn(position & 3, opxy::platform::shift_held(), dial(event), 0), ott::mix_index))
+        return;
+    sdk_master_stock_turn(controller, position, event);
+}
+
+void sdk_master_frame(void* screen, i32 elapsed) {
+    if (mix_open()) {
+        ott::Panel panel{};
+        if (controls.panel(panel, opxy::platform::shift_held()) && draw_panel(panel)) return;
+    }
+    sdk_master_stock_frame(screen, elapsed);
+}
+
+void sdk_master_process(void* context, i32* left, i32* right) {
+    stock<void(void*, i32*, i32*)>(0x11a02c10)(context, left, right);
+    audio.process_mix(left, right);
+}
+
+void ott_bind_project(u32 project) { loading_project = project; }
+
+void ott_load_kept(const unsigned char* data, u32 count) {
+    pending_project = {};
+    ott::decode_project(data, count, pending_project);
+}
+
+u32 ott_save_kept(unsigned char* data, u32 capacity) {
+    return capacity >= ott::project_bytes ? ott::encode_project(controls.project(), data) : 0;
+}
+
+void ott_clear_project() {
+    loading_project = 0;
+    controls.load({});
+    publish(0, true);
+}
+
+u32 sdk_ott_activate() {
+    const u32 project = stock<u32()>(0x8d584210)();
+    if (project && (project == loading_project || project != current_project)) {
+        controls.load(project == loading_project ? pending_project : ott::ProjectSettings{});
+        loading_project = 0;
+        current_project = project;
+        publish(0, true);
+    }
+    return project;
+}
