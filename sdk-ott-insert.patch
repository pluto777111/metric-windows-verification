diff --git a/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp b/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp
new file mode 100644
index 0000000..8ae7fd6
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp
@@ -0,0 +1,141 @@
+#pragma once
+
+#include "track_insert.hpp"
+
+namespace ott {
+
+struct ProjectSettings {
+    TrackSettings track[TrackInserts::track_count];
+};
+
+enum class Page { other, envelope, ott };
+enum class InputResult { stock, handled, page_changed, settings_changed, insert_limit };
+
+struct EncoderValue {
+    const char* label;
+    i32 value;
+};
+
+struct Panel {
+    u32 track_number;
+    u32 enabled_count;
+    bool enabled;
+    EncoderValue encoders[4];
+};
+
+// Owned by the controller role. A platform adapter supplies the current track
+// and stock page and publishes a complete ProjectSettings snapshot on changes.
+class DeviceControls {
+public:
+    void select(u32 track, Page stock_page) {
+        if (track != track_ || stock_page != Page::envelope) open_ = false;
+        track_ = track;
+        stock_page_ = stock_page;
+    }
+
+    Page page() const { return open_ ? Page::ott : stock_page_; }
+
+    // The first M2 press selects the stock envelope screen. Repeat M2 to
+    // switch between it and OTT. Every other module key stays with stock.
+    InputResult module(u32 number, bool shifted) {
+        if (number != 2 || shifted) {
+            open_ = false;
+            return InputResult::stock;
+        }
+        if (track_ >= TrackInserts::track_count || stock_page_ != Page::envelope)
+            return InputResult::stock;
+        open_ = !open_;
+        return InputResult::page_changed;
+    }
+
+    InputResult click(u32 encoder, bool shifted) {
+        if (!open_ || encoder >= 4) return InputResult::stock;
+        if (shifted) {
+            if (encoder != 3) return InputResult::stock;
+            auto& settings = project_.track[track_];
+            if (!settings.enabled && count(project_) >= TrackInserts::insert_limit)
+                return InputResult::insert_limit;
+            settings.enabled = !settings.enabled;
+            return InputResult::settings_changed;
+        }
+        auto& position = shown_[track_][encoder];
+        const u32 count = encoder == 0 ? 3 : 2;
+        const u32 next = static_cast<u32>(position) + 1;
+        position = next == count ? 0 : static_cast<opxy::u8>(next);
+        return InputResult::page_changed;
+    }
+
+    InputResult turn(u32 encoder, bool shifted, i32 detents, u32 acceleration) {
+        if (!open_ || encoder >= 4) return InputResult::stock;
+        if (shifted) return InputResult::handled;
+        const Binding param = binding(encoder);
+        i32& value = project_.track[track_].controls.*param.value;
+        const i32 bounded = detents < -127 ? -127 : detents > 127 ? 127 : detents;
+        const i32 speed = acceleration < 3 ? static_cast<i32>(acceleration + 1) : 4;
+        // The offset can exceed one Q31 word for accelerated turns.
+        const auto change = static_cast<opxy::i64>(bounded) * speed * (q31::maximum / 100);
+        const i32 next = q31::saturate(static_cast<opxy::i64>(value) + change);
+        const i32 normalized = next < 0 ? 0 : next;
+        if (value == normalized) return InputResult::handled;
+        value = normalized;
+        return InputResult::settings_changed;
+    }
+
+    bool panel(Panel& panel) const {
+        if (!open_) return false;
+        const auto& settings = project_.track[track_];
+        panel.track_number = track_ + 1;
+        panel.enabled = settings.enabled;
+        panel.enabled_count = count(project_);
+        for (u32 i = 0; i < 4; ++i) {
+            const Binding param = binding(i);
+            panel.encoders[i] = {param.label, settings.controls.*param.value};
+        }
+        return true;
+    }
+
+    const ProjectSettings& project() const { return project_; }
+
+    bool load(const ProjectSettings& project) {
+        if (count(project) > TrackInserts::insert_limit) return false;
+        project_ = project;
+        open_ = false;
+        for (auto& track : shown_) for (auto& position : track) position = 0;
+        return true;
+    }
+
+private:
+    struct Binding {
+        const char* label;
+        i32 Controls::*value;
+    };
+
+    Binding binding(u32 encoder) const {
+        static constexpr Binding main[] = {
+            {"Character", &Controls::character}, {"Low Protect", &Controls::low_protect},
+            {"Time", &Controls::time}, {"Mix", &Controls::mix},
+        };
+        static constexpr Binding secondary[] = {
+            {"Upward", &Controls::upward}, {"Downward", &Controls::downward},
+            {"Attack", &Controls::attack}, {"Output Trim", &Controls::trim},
+        };
+        const u32 position = shown_[track_][encoder];
+        if (position == 1) return secondary[encoder];
+        if (position == 2) return {"Post Cutoff", &Controls::post_cutoff};
+        return main[encoder];
+    }
+
+    static u32 count(const ProjectSettings& project) {
+        u32 enabled = 0;
+        for (const auto& track : project.track) enabled += track.enabled;
+        return enabled;
+    }
+
+    ProjectSettings project_;
+    opxy::u8 shown_[TrackInserts::track_count][4] = {};
+    u32 track_ = TrackInserts::track_count;
+    Page stock_page_ = Page::other;
+    bool open_ = false;
+};
+
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp b/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp
new file mode 100644
index 0000000..d35c5d1
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/firmware_runtime.hpp
@@ -0,0 +1,130 @@
+#pragma once
+#include "device_controls.hpp"
+
+namespace ott {
+constexpr u32 parameter_count = 9;
+constexpr i32 Controls::* parameters[] = {
+    &Controls::character, &Controls::low_protect, &Controls::time,
+    &Controls::mix, &Controls::upward, &Controls::downward,
+    &Controls::attack, &Controls::trim, &Controls::post_cutoff
+};
+constexpr u32 project_bytes = 1 + TrackInserts::track_count * (1 + 4 * parameter_count);
+constexpr u32 message_id = 128, last_parameter_id = message_id + parameter_count;
+using Byte = unsigned char;
+
+inline u32 encode_project(const ProjectSettings& project, Byte* data) {
+    data[0] = 1;
+    u32 at = 1;
+    for (const auto& track : project.track) {
+        data[at++] = track.enabled;
+        for (const auto parameter : parameters) {
+            const u32 value = static_cast<u32>(track.controls.*parameter);
+            for (u32 byte = 0; byte < 4; ++byte) data[at++] = static_cast<Byte>(value >> (8 * byte));
+        }
+    }
+    return at;
+}
+
+inline bool decode_project(const Byte* data, u32 count, ProjectSettings& project) {
+    if (count != project_bytes || !data || data[0] != 1) return false;
+    ProjectSettings next{};
+    u32 at = 1, enabled = 0;
+    for (auto& track : next.track) {
+        if (data[at] > 1) return false;
+        track.enabled = data[at++] != 0;
+        enabled += track.enabled;
+        for (const auto parameter : parameters) {
+            u32 value = 0;
+            for (u32 byte = 0; byte < 4; ++byte) value |= static_cast<u32>(data[at++]) << (8 * byte);
+            if (value > static_cast<u32>(q31::maximum)) return false;
+            track.controls.*parameter = static_cast<i32>(value);
+        }
+    }
+    if (enabled > TrackInserts::insert_limit) return false;
+    project = next;
+    return true;
+}
+
+template <class Send>
+void publish(const ProjectSettings& project, u32 selection, bool reset, u32 sequence, Send send) {
+    const u32 first = selection ? selection - 1 : 0;
+    const u32 end = selection ? selection : TrackInserts::track_count;
+    u32 enable = 0;
+    for (u32 index = first; index < end; ++index)
+        if (project.track[index].enabled) enable |= 1u << index;
+    sequence &= 0x7fffu;
+    send(message_id, static_cast<i32>(sequence << 16 | enable << 8 | selection << 1 | (reset ? 1u : 0u)));
+    for (u32 index = first; index < end; ++index)
+        for (u32 slot = 0; slot < parameter_count; ++slot)
+            send(message_id + 1 + slot, project.track[index].controls.*parameters[slot]);
+    send(message_id, static_cast<i32>(0x80000000u | sequence));
+}
+
+class AudioInsert {
+public:
+    bool receive(u32 id, i32 value) {
+        if (id < message_id || id > last_parameter_id) return false;
+        const u32 word = static_cast<u32>(value);
+        if (id == message_id && !(word & 0x80000000u)) {
+            begin(word);
+        } else if (id == message_id) {
+            if (reading_ && index_ == end_ && word == (0x80000000u | sequence_)) {
+                u32 enabled = 0;
+                for (const auto& track : staged_.track) enabled += track.enabled;
+                if (enabled <= TrackInserts::insert_limit) {
+                    pending_ = staged_;
+                    changed_ = true;
+                    reset_pending_ = reset_pending_ || reset_;
+                }
+            }
+            reading_ = false;
+        } else if (reading_) {
+            if (index_ == end_ || id != message_id + 1 + slot_ || value < 0) {
+                reading_ = false;
+            } else {
+                staged_.track[index_].controls.*parameters[slot_] = value;
+                if (++slot_ == parameter_count) {
+                    slot_ = 0;
+                    ++index_;
+                }
+            }
+        }
+        return true;
+    }
+
+    void start_track(u32 track) {
+        // The stock mixer visits instrument tracks in ascending order and may
+        // skip external MIDI tracks. Detect the next block at the wrap.
+        if (track <= last_track_ && changed_) {
+            inserts_.configure(pending_.track);
+            if (reset_pending_) inserts_.reset();
+            changed_ = reset_pending_ = false;
+        }
+        last_track_ = track;
+    }
+
+    bool needs_tail(u32 track) const { return inserts_.needs_tail(track); }
+    u32 process(u32 track, i32* sum, u32 voices) { return inserts_.process(track, sum, voices); }
+
+private:
+    void begin(u32 word) {
+        const u32 selected = (word >> 1) & 15;
+        reading_ = selected <= TrackInserts::track_count && !(word & 0xe0);
+        if (!reading_) return;
+        reset_ = (word & 1) != 0;
+        sequence_ = word >> 16;
+        index_ = selected ? selected - 1 : 0;
+        end_ = selected ? selected : TrackInserts::track_count;
+        slot_ = 0;
+        staged_ = pending_;
+        for (u32 index = index_; index < end_; ++index)
+            staged_.track[index].enabled = ((word >> (8 + index)) & 1) != 0;
+    }
+
+    TrackInserts inserts_;
+    ProjectSettings pending_{}, staged_{};
+    u32 last_track_ = TrackInserts::track_count;
+    u32 sequence_ = 0, index_ = 0, end_ = 0, slot_ = 0;
+    bool reading_ = false, reset_ = false, changed_ = false, reset_pending_ = false;
+};
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp b/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp
new file mode 100644
index 0000000..e564f23
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/ott.hpp
@@ -0,0 +1,223 @@
+#pragma once
+
+#include <opxy/audio.hpp>
+#include <opxy/q31.hpp>
+
+namespace ott {
+using opxy::i32;
+using opxy::u32;
+namespace q31 = opxy::q31;
+
+// Normalized Q31 encoder values, ordered left to right on each row.
+struct Controls {
+    i32 character = q31::maximum / 2;
+    i32 low_protect = q31::maximum / 4;
+    i32 time = q31::maximum / 2;
+    i32 mix = q31::maximum;
+    i32 upward = 1546188226; // 72%
+    i32 downward = 1546188226; // 72%
+    i32 attack = q31::maximum / 2;
+    i32 trim = q31::maximum / 2;
+    i32 post_cutoff = q31::maximum;
+};
+
+// One instance per stereo track, zero-initialized or reset on activation.
+class Processor {
+public:
+    void reset() { *this = Processor{}; }
+
+    bool settled() const {
+        for (u32 ch = 0; ch < 2; ++ch) {
+            if (low_[ch] || mid_[ch] || post_first_[ch] || post_second_[ch]) return false;
+        }
+        for (i32 level : envelope_) {
+            if (level) return false;
+        }
+        return true;
+    }
+
+    // Normalized Q31 controls. sum holds 64 interleaved stereo frames at 44.1 kHz.
+    void process(i32* sum, const Controls& controls) {
+        const i32 mix = positive(controls.mix);
+        if (!mix) return;
+        const i32 character = positive(controls.character);
+        const i32 release = 230000000 - q31::multiply(positive(controls.time), 210000000);
+        const i32 attack = 1900000000 - q31::multiply(positive(controls.attack), 800000000);
+        // One-pole coefficient range of about 1.1 to 4.4 kHz at 44.1 kHz.
+        const i32 crossover = 320000000 + q31::multiply(character, 664000000);
+        const i32 brightness = bipolar(character);
+        const i32 upward = positive(controls.upward);
+        const i32 downward = positive(controls.downward);
+        const i32 compensation = depth_trim(upward);
+        const i32 trim = bipolar(positive(controls.trim));
+        const i32 output_delta = q31::multiply(trim, trim < 0 ? 627000000 : 886000000);
+        const i32 cutoff = positive(controls.post_cutoff);
+        const bool post_filter = cutoff < q31::maximum;
+        const i32 post_coefficient = post_filter ? cutoff_coefficient(cutoff) : 0;
+        if (!post_filter) {
+            for (u32 ch = 0; ch < 2; ++ch) {
+                post_first_[ch] = post_second_[ch] = 0;
+            }
+        }
+        const bool fully_wet = mix == q31::maximum;
+        i32 peak[3] = {};
+        i32 split[2 * opxy::block_frames][3];
+        for (u32 frame = 0; frame < opxy::block_frames; ++frame) {
+            for (u32 ch = 0; ch < 2; ++ch) {
+                const u32 index = 2 * frame + ch;
+                // Leave headroom for the differences of the crossover states.
+                const i32 dry = q31::shift_right(sum[index], 3);
+                const i32 low = follow(low_[ch], dry, 69100000); // 230 Hz
+                const i32 rest = dry - low;
+                const i32 mid = follow(mid_[ch], rest, crossover);
+                split[index][0] = low;
+                split[index][1] = mid;
+                split[index][2] = rest - mid;
+                for (u32 band = 0; band < 3; ++band) {
+                    const i32 value = split[index][band];
+                    const i32 magnitude = value < 0 ? ~value : value;
+                    if (magnitude > peak[band]) peak[band] = magnitude;
+                }
+            }
+        }
+        i32 gain[3], step[3], target[3];
+        for (u32 band = 0; band < 3; ++band) {
+            // Use this block's detector so the previous quiet block's upward
+            // gain cannot be carried into a loud hit.
+            const i32 band_release = release + (release / 2) * static_cast<i32>(band);
+            follow(envelope_[band], peak[band],
+                   peak[band] > envelope_[band] ? attack : band_release);
+            gain[band] = unity + gain_delta_[band];
+            // The high band normally carries less energy. Offset its knee
+            // so quiet cymbal, noise and harmonics stay in the lift region.
+            const i32 detector = band == 2 ? q31::half(envelope_[band]) : envelope_[band];
+            const i32 delta = curve(detector) - unity;
+            const i32 strength = delta > 0 ? upward : downward;
+            const i32 protected_strength = band == 0
+                ? q31::multiply(strength, q31::maximum - positive(controls.low_protect))
+                : strength;
+            i32 band_gain = unity + q31::multiply(protected_strength, delta);
+            if (upward) band_gain = q31::multiply(compensation, band_gain);
+            if (band == 2) band_gain += q31::multiply(band_gain, q31::multiply(brightness, 240000000));
+            band_gain += q31::multiply(band_gain, output_delta);
+            target[band] = band_gain - unity;
+            if (peak[band] > envelope_[band]) {
+                const i32 current_peak = band == 2 ? q31::half(peak[band]) : peak[band];
+                const i32 peak_delta = curve(current_peak) - unity;
+                if (peak_delta <= 0) {
+                    // Remove upward gain immediately on a transient entering
+                    // compression. The Attack knob still sets detector speed.
+                    if (target[band] > 0) target[band] = 0;
+                    if (gain[band] > unity) gain[band] = unity;
+                }
+            }
+            step[band] = (target[band] - (gain[band] - unity)) / static_cast<i32>(opxy::block_frames);
+        }
+
+        // Seed the two poles from the current wet signal when engaging them.
+        const bool start_post = post_filter && !post_active_;
+        post_active_ = post_filter;
+        for (u32 frame = 0; frame < opxy::block_frames; ++frame) {
+            for (u32 band = 0; band < 3; ++band) gain[band] += step[band];
+            for (u32 ch = 0; ch < 2; ++ch) {
+                i32& sample = sum[2 * frame + ch];
+                // Q28 gains leave room for boost and recombination in Q31.
+                i32 wet = 0;
+                for (u32 band = 0; band < 3; ++band)
+                    wet += q31::multiply(split[2 * frame + ch][band], gain[band]);
+                if (post_filter) {
+                    if (start_post && frame == 0) post_first_[ch] = post_second_[ch] = wet;
+                    const i32 first = follow_post(post_first_[ch], wet, post_coefficient);
+                    wet = follow_post(post_second_[ch], first, post_coefficient);
+                }
+                if (post_filter || gain[0] != unity || gain[1] != unity || gain[2] != unity) {
+                    if (!fully_wet) {
+                        const i32 dry_scaled = q31::shift_right(sample, 6);
+                        wet = dry_scaled + q31::multiply(mix, wet - dry_scaled);
+                    }
+                    sample = q31::shift_left(wet, 6);
+                }
+            }
+        }
+
+        for (u32 band = 0; band < 3; ++band) gain_delta_[band] = target[band];
+    }
+
+private:
+    static constexpr i32 unity = 1 << 28; // Q28
+    i32 low_[2] = {};
+    i32 mid_[2] = {};
+    i32 post_first_[2] = {};
+    i32 post_second_[2] = {};
+    bool post_active_ = false;
+    i32 envelope_[3] = {};
+    i32 gain_delta_[3] = {};
+
+    static i32 follow_post(i32& state, i32 input, i32 coefficient) {
+        // Snap only on silence so ordinary low-level stereo detail remains linear.
+        if (!input && state > -32 && state < 32) state = 0;
+        else state += q31::multiply(coefficient, input - state);
+        return state;
+    }
+
+    // Two cascaded one-poles. Table entries target the combined -3 dB
+    // frequency, with the last segment opening smoothly toward bypass.
+    static i32 cutoff_coefficient(i32 cutoff) {
+        const i32 coefficients[] = {
+            83881775, 146822686, 254354639, 425361901,
+            700499261, 1068843850, 1475027432, 1787043948, 2147483647
+        };
+        const u32 segment = static_cast<u32>(cutoff) >> 28;
+        const i32 fraction = (cutoff & ((1 << 28) - 1)) * 8;
+        return coefficients[segment]
+            + q31::multiply(fraction, coefficients[segment + 1] - coefficients[segment]);
+    }
+
+    // Wet gain compensation calibrated at quarter-strength intervals using
+    // drum pulses, a bass phrase and a sustained chord. Folded into band gains
+    // once per block, before the wet/dry blend.
+    static i32 depth_trim(i32 depth) {
+        const i32 trims[] = {2147483647, 2133928508, 2111931683, 2075773032, 2026188590};
+        const u32 segment = static_cast<u32>(depth) >> 29;
+        const i32 fraction = (depth & ((1 << 29) - 1)) * 4;
+        return trims[segment] + q31::multiply(fraction, trims[segment + 1] - trims[segment]);
+    }
+
+    static i32 bipolar(i32 value) {
+        return value == q31::maximum ? q31::maximum : (value - q31::maximum / 2) * 2;
+    }
+
+    static i32 positive(i32 value) { return value > 0 ? value : 0; }
+
+    static i32 follow(i32& state, i32 input, i32 coefficient) {
+        const i32 difference = input - state;
+        // Fixed-point steps can round to zero near the target. Snap here
+        // so a silent track reaches exact zero instead of emitting residual DC.
+        if (difference > -128 && difference < 128) state = input;
+        else state += q31::multiply(coefficient, difference);
+        return state;
+    }
+
+    // Gain at detector levels doubling from approx. -72 to 0 dBFS.
+    // Quiet material gets upward compression above a floor, loud material
+    // gets downward compression. Below the floor the gain returns to unity.
+    static i32 curve(i32 level) {
+        const i32 gains[] = {
+            unity, unity, 4 * unity, 5 * unity, 5 * unity, 4 * unity + unity / 2,
+            4 * unity, 2 * unity + unity / 2, unity + unity / 4, unity / 2,
+            unity / 3, unity / 5, unity / 6
+        };
+        u32 index = 0;
+        u32 shift = 16;
+        i32 edge = 1 << shift;
+        if (level <= edge) return unity;
+        while (index < 11 && level >= edge * 2) {
+            ++index;
+            ++shift;
+            edge *= 2;
+        }
+        const i32 fraction = q31::shift_left(level - edge, 31 - shift);
+        return gains[index] + q31::multiply(fraction, gains[index + 1] - gains[index]);
+    }
+};
+}
diff --git a/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp b/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp
new file mode 100644
index 0000000..2e0c707
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/track_insert.hpp
@@ -0,0 +1,74 @@
+#pragma once
+
+#include "ott.hpp"
+
+namespace ott {
+
+// Track indices are zero-based. The SDK adapter owns project settings and
+// hands a complete snapshot to configure() on the audio role.
+struct TrackSettings {
+    bool enabled = false;
+    Controls controls;
+};
+
+class TrackInserts {
+public:
+    static constexpr u32 track_count = 8;
+    static constexpr u32 insert_limit = 4;
+
+    // Apply a complete validated snapshot at a block boundary. Reject a fifth
+    // enabled insert without changing any track's settings or audio state.
+    bool configure(const TrackSettings (&settings)[track_count]) {
+        u32 enabled = 0;
+        for (const auto& config : settings) {
+            if (config.enabled) ++enabled;
+        }
+        if (enabled > insert_limit) return false;
+        for (u32 index = 0; index < track_count; ++index) {
+            auto& track = tracks_[index];
+            track.settings = settings[index];
+            if (!track.settings.enabled || track.settings.controls.mix <= 0) track.sleep();
+        }
+        return true;
+    }
+
+    // Called on the audio role after project activation, before its first block.
+    void reset() {
+        for (auto& track : tracks_) track.sleep();
+    }
+
+    bool needs_tail(u32 index) const { return index < track_count && tracks_[index].active; }
+
+    // Called on the audio role when the mixer has finished summing one track.
+    // The returned count keeps the mixer's tail path open when needed.
+    u32 process(u32 index, i32* sum, u32 voices) {
+        if (index >= track_count) return voices;
+        auto& track = tracks_[index];
+        const auto& settings = track.settings;
+        if (!settings.enabled || settings.controls.mix <= 0) return voices;
+        if (!track.active && !voices) return 0;
+        track.active = true;
+        track.processor.process(sum, settings.controls);
+        if (voices) return voices;
+        for (u32 word = 0; word < 2 * opxy::block_frames; ++word) {
+            if (sum[word]) return 1;
+        }
+        if (track.processor.settled()) track.sleep();
+        return 0;
+    }
+
+private:
+    struct Track {
+        TrackSettings settings;
+        Processor processor;
+        bool active = false;
+
+        void sleep() {
+            if (active) processor.reset();
+            active = false;
+        }
+    };
+    Track tracks_[track_count];
+};
+
+}
