diff --git a/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp b/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp
new file mode 100644
index 0000000..fa6cfbe
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/ott_filter/device_controls.hpp
@@ -0,0 +1,189 @@
+#pragma once
+
+#include "track_insert.hpp"
+
+namespace ott {
+
+constexpr u32 mix_index = TrackInserts::track_count;
+constexpr u32 settings_count = mix_index + 1;
+
+constexpr TrackSettings mix_defaults() { return TrackSettings(Controls(q31::maximum / 3, Mix)); }
+
+struct ProjectSettings {
+    TrackSettings track[TrackInserts::track_count]{};
+    TrackSettings mix = mix_defaults();
+};
+
+enum class Page { other, envelope, ott };
+enum class InputResult { stock, handled, page_changed, settings_changed, insert_limit };
+
+struct EncoderValue {
+    const char* label;
+    i32 value;
+};
+
+struct Panel {
+    u32 track_number;
+    u32 enabled_count;
+    bool enabled;
+    bool shifted;
+    EncoderValue encoders[4], primary[4], secondary[3];
+    bool alternate[4];
+};
+
+// Owned by the controller role. A platform adapter supplies the current track
+// and stock page and publishes a complete ProjectSettings snapshot on changes.
+class DeviceControls {
+public:
+    void select(u32 track, Page stock_page) {
+        if (track != track_ || stock_page != Page::envelope) open_ = false;
+        track_ = track;
+        stock_page_ = stock_page;
+    }
+
+    void select_mix(bool on_eq) { select(mix_index, on_eq ? Page::envelope : Page::other); }
+    bool is_mix() const { return track_ == mix_index; }
+
+    Page page() const { return open_ ? Page::ott : stock_page_; }
+
+    // The first M2 press selects the stock envelope screen. Repeat M2 to
+    // switch between it and OTT. Every other module key stays with stock.
+    InputResult module(u32 number, bool shifted) {
+        if (number != 2 || shifted) {
+            open_ = false;
+            return InputResult::stock;
+        }
+        if (track_ >= settings_count || stock_page_ != Page::envelope)
+            return InputResult::stock;
+        open_ = !open_;
+        return InputResult::page_changed;
+    }
+
+    InputResult click(u32 encoder, bool shifted) {
+        if (!open_ || encoder >= 4) return InputResult::stock;
+        if (shifted) return InputResult::handled;
+        if (encoder == 3) return set_enabled(!settings().enabled);
+        auto& position = shown_[track_][encoder];
+        position = !position;
+        return InputResult::page_changed;
+    }
+
+    InputResult turn(u32 encoder, bool shifted, i32 detents, u32 acceleration) {
+        if (!open_ || encoder >= 4) return InputResult::stock;
+        const Binding param = binding(encoder, shifted);
+        i32& value = settings().controls.*param.value;
+        const i32 choices = param.value == &Controls::character ? 3 : param.value == &Controls::focus ? 4 : 0;
+        if (choices) {
+            const i32 detent = detents < 0 ? -1 : detents > 0 ? 1 : 0;
+            const i32 requested = value + detent;
+            const i32 next = requested < 0 ? 0 : requested >= choices ? choices - 1 : requested;
+            if (next == value) return InputResult::handled;
+            value = next;
+            return InputResult::settings_changed;
+        }
+        if (param.value == &Controls::level_match) {
+            if (!detents) return InputResult::handled;
+            const i32 next = detents > 0 ? q31::maximum : 0;
+            if (value == next) return InputResult::handled;
+            value = next;
+            return InputResult::settings_changed;
+        }
+        const i32 bounded = detents < -127 ? -127 : detents > 127 ? 127 : detents;
+        const i32 speed = acceleration < 3 ? static_cast<i32>(acceleration + 1) : 4;
+        // The offset can exceed one Q31 word for accelerated turns.
+        const auto change = q31::wide(bounded * speed, q31::maximum / 100);
+        const i32 next = q31::saturate(static_cast<opxy::i64>(value) + change);
+        const i32 normalized = next < 0 ? 0 : next;
+        if (value == normalized) return InputResult::handled;
+        value = normalized;
+        return InputResult::settings_changed;
+    }
+
+    bool panel(Panel& panel, bool shifted = false) const {
+        if (!open_) return false;
+        const auto& settings = this->settings();
+        panel.track_number = is_mix() ? 0 : track_ + 1;
+        panel.enabled = settings.enabled;
+        panel.shifted = shifted;
+        panel.enabled_count = count(project_);
+        for (u32 i = 0; i < 4; ++i) {
+            panel.alternate[i] = !shifted && i < 3 && shown_[track_][i];
+            panel.encoders[i] = read(binding(i, shifted), settings.controls);
+            panel.primary[i] = read(plain(i, false), settings.controls);
+            if (i < 3) panel.secondary[i] = read(plain(i, true), settings.controls);
+        }
+        return true;
+    }
+
+    const ProjectSettings& project() const { return project_; }
+
+    bool load(const ProjectSettings& project) {
+        if (count(project) > TrackInserts::insert_limit) return false;
+        project_ = project;
+        open_ = false;
+        for (auto& track : shown_) for (auto& position : track) position = 0;
+        return true;
+    }
+
+private:
+    TrackSettings& settings() { return is_mix() ? project_.mix : project_.track[track_]; }
+    const TrackSettings& settings() const { return is_mix() ? project_.mix : project_.track[track_]; }
+
+    struct Binding {
+        const char* label;
+        i32 Controls::*value;
+    };
+
+    static EncoderValue read(Binding param, const Controls& controls) {
+        const i32 value = controls.*param.value;
+        if (param.value == &Controls::character) {
+            const char* const names[] = {"Drum", "Pad", "Mix"};
+            return {names[value], value * (q31::maximum / 2)};
+        }
+        if (param.value == &Controls::focus) {
+            const char* const names[] = {"Stereo", "Mid", "Side", "Mono"};
+            return {names[value], value * (q31::maximum / 3)};
+        }
+        return {param.label, value};
+    }
+
+    static Binding plain(u32 encoder, bool alternate) {
+        static constexpr Binding bindings[3][2] = {
+            {{"Time", &Controls::time}, {"Level Match", &Controls::level_match}},
+            {{"Low", &Controls::low_trim}, {"Character", &Controls::character}},
+            {{"High", &Controls::high_trim}, {"Focus", &Controls::focus}},
+        };
+        return encoder == 3 ? Binding{"Depth", &Controls::depth} : bindings[encoder][alternate];
+    }
+
+    Binding binding(u32 encoder, bool shifted) const {
+        static constexpr Binding shift_controls[] = {
+            {"Crossover", &Controls::crossover}, {"Low Protect", &Controls::low_protect},
+            {"Upward", &Controls::upward}, {"Downward", &Controls::downward},
+        };
+        if (shifted) return shift_controls[encoder];
+        return plain(encoder, encoder < 3 && shown_[track_][encoder]);
+    }
+
+    InputResult set_enabled(bool enabled) {
+        auto& settings = this->settings();
+        if (settings.enabled == enabled) return InputResult::handled;
+        if (enabled && !is_mix() && count(project_) >= TrackInserts::insert_limit) return InputResult::insert_limit;
+        settings.enabled = enabled;
+        return InputResult::settings_changed;
+    }
+
+    static u32 count(const ProjectSettings& project) {
+        u32 enabled = 0;
+        for (const auto& track : project.track) enabled += track.enabled;
+        return enabled;
+    }
+
+    ProjectSettings project_;
+    opxy::u8 shown_[settings_count][3] = {};
+    u32 track_ = settings_count;
+    Page stock_page_ = Page::other;
+    bool open_ = false;
+};
+
+}
