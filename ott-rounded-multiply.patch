+// The Q31 product rounded to nearest, (a * b + 2^30) >> 31, with exact halves
+// rounded to even and MIN * MIN held at maximum.
+inline i32 multiply_rounded(i32 a, i32 b) {
+#if defined(__bfin__)
+    // Blackfin+'s 32 x 32 fractional multiply in its default rounding mode:
+    // one instruction (unbiased rounding with ASTAT.RND_MOD clear).
+    i32 result;
+    __asm__("%0 = %1 * %2;" : "=d"(result) : "d"(a), "d"(b) : "ASTAT", "CC");
+    return result;
+#else
+    if (a == -maximum - 1 && b == -maximum - 1) return maximum;
+    const i64 product = static_cast<i64>(a) * b;
+    const i64 scale = static_cast<i64>(1) << 31;
+    i64 floor = product / scale;
+    i64 remainder = product % scale;
+    if (remainder < 0) { --floor; remainder += scale; }
+    const i64 half = scale / 2;
+    if (remainder > half || (remainder == half && (floor & 1))) ++floor;
+    return static_cast<i32>(floor);
+#endif
+}
